; https://editorconfig.org/

root = true

[*]
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 4
eclint_indent_style = unset

[*.{c,h,m}]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
max_line_length = 100
tab_width = 2
ij_continuation_indent_size = 4
ij_smart_tabs = false
ij_wrap_on_typing = false
